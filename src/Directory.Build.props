<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../artifacts</ArtifactsPath>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../local-feed</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
